# ─── База даних ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ─── Додаток ──────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# ─── SMTP-пошта ───────────────────────────────────────────────────────────────
# Детально налаштовується в адмінці: Налаштування → Пошта.
# Ці значення — fallback, якщо адмінка ще не заповнена.
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USER=your@email.com
MAIL_PASS=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="Назва магазину"
